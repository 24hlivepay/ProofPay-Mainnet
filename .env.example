# Circle's official Arc Mainnet RPC (docs.arc.io/arc/references/rpc-endpoints).
# NOTE: as of the Sept 16 2026 mainnet launch, Circle's docs still say this
# primary endpoint is "permissioned and require[s] credentials" during the
# private mainnet phase. If requests fail with an auth/connection error,
# request access via your Circle point of contact before assuming this URL
# is wrong. Alternate providers (Alchemy, Blockdaemon, dRPC, QuickNode) are
# listed on the same docs page if you get mainnet API keys from them instead.
RPC_URL=https://rpc.mainnet.arc.io
PRIVATE_KEY=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Set to EURC, CIRBTC, or ALL when using scripts/deploy-assets.ts.
# CIRBTC currently has no published Arc Mainnet contract — the script will
# skip it (or error, if requested explicitly) until Circle documents one.
DEPLOY_ASSET=ALL
