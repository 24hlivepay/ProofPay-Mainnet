# Use /api when frontend and backend are deployed through the root vercel.json.
VITE_API_URL=/api

# Circle App ID, per Arc network — both are baked into the same build; the
# network toggle (Navbar.jsx) picks between them at runtime. See
# src/config/network.js. VITE_CIRCLE_APP_ID (no suffix) still works as a
# legacy fallback for testnet only.
VITE_CIRCLE_APP_ID_TESTNET=
VITE_CIRCLE_APP_ID_MAINNET=

# Escrow contract addresses are fixed in src/config/escrowAssets.js (no env override,
# so a stale variable can never point the app back at a retired contract).
VITE_DISPUTE_ADMIN_WALLET=
